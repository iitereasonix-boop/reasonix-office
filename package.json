{
  "name": "reasonix-law-office",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "db:deploy": "prisma migrate deploy",
    "db:demo": "tsx --env-file=.env prisma/seed-demo.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "test": "tsx --env-file=.env --test tests/unit.test.ts",
    "test:rls": "node --env-file=.env --test tests/rls.test.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "test:e2e": "node tests/run-e2e.mjs",
    "reset-password": "node --env-file=.env scripts/reset-password.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "^15.5.0",
    "pg": "^8.13.1",
    "prisma": "^6.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.5",
    "unpdf": "^2.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "jszip": "^3.10.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "postcss": "^8.5.23"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
