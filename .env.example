# Run scripts/setup-database.ps1 to create the local database and write .env,
# or use `npm run db:local` and the URL in README.md.
DATABASE_URL=
INITIAL_LAWYER_EMAIL=
INITIAL_LAWYER_PASSWORD=

# Required in production: AES-256-GCM key for national IDs and private notes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a safe copy. Encrypted fields cannot be read without it.
FIELD_ENCRYPTION_KEY=

# مساعد العلاء: the key alone does nothing until the senior lawyer enables AI in settings.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# WhatsApp Cloud API. Empty means messages are sent by hand from wa.me links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Railway only. See the deployment section of README.md.
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
BACKUP_DIR=

# Public site. Leave empty until confirmed; the buttons then open the booking section.
NEXT_PUBLIC_OFFICE_PHONE=
NEXT_PUBLIC_OFFICE_WHATSAPP=
NEXT_PUBLIC_OFFICE_ADDRESS=
