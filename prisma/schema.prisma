generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String
  role                Role
  canViewPrivateNotes Boolean        @default(false)
  canViewNationalId   Boolean        @default(false)
  active              Boolean        @default(true)
  calendarToken       String?        @unique
  createdAt           DateTime       @default(now())
  auditEntries        AuditLog[]
  conversations       Conversation[]
  documents           Document[]
  assignedCases       LegalCase[]    @relation("AssignedLawyer")
  traineeCases        LegalCase[]    @relation("TraineeLawyer")
  draftsCreated       LegalDraft[]   @relation("DraftAuthor")
  draftsReviewed      LegalDraft[]   @relation("DraftReviewer")
  sessions            Session[]
  tasks               Task[]
  caseUpdates         CaseUpdate[]
  agentRuns           AgentRun[]
  expensesCreated     CaseExpense[]
  timeEntries         TimeEntry[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Client {
  id               String      @id @default(cuid())
  name             String
  nationalId       String?
  phone            String
  address          String?
  notes            String?
  userId           String?     @unique
  whatsappOptOutAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  cases            LegalCase[]
  messages         Message[]

  @@index([phone])
  @@index([name])
}

model LegalCase {
  id               String         @id @default(cuid())
  caseNumber       String         @unique
  title            String
  summary          String?
  courtCity        String?
  mojCourt         String?
  mojJurisdiction  String?
  mojRegistry      String?
  mojNumber        String?
  mojYear          Int?
  type             CaseType
  court            CourtLevel
  opposingParties  String[]
  status           CaseStatus     @default(OPEN)
  clientId         String
  assignedLawyerId String
  traineeLawyerId  String?
  privateNotes     String?
  fees             Decimal?       @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  auditEntries     AuditLog[]
  conversations    Conversation[]
  documents        Document[]
  hearings         Hearing[]
  judgments        Judgment[]
  assignedLawyer   User           @relation("AssignedLawyer", fields: [assignedLawyerId], references: [id])
  client           Client         @relation(fields: [clientId], references: [id])
  traineeLawyer    User?          @relation("TraineeLawyer", fields: [traineeLawyerId], references: [id])
  drafts           LegalDraft[]
  messages         Message[]
  tasks            Task[]
  updates          CaseUpdate[]
  invoices         Invoice[]
  expenses         CaseExpense[]
  timeEntries      TimeEntry[]

  @@index([clientId, status])
  @@index([assignedLawyerId])
  @@index([traineeLawyerId])
}

model Hearing {
  id           String    @id @default(cuid())
  caseId       String
  startsAt     DateTime
  courtroom    String?
  judge        String?
  purpose      String?
  notes        String?
  decision     String?
  nextStartsAt DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  legalCase    LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([startsAt])
  @@index([caseId, startsAt])
}

model Message {
  id             String           @id @default(cuid())
  clientId       String?
  caseId         String?
  body           String
  status         MessageStatus    @default(DRAFT)
  channel        String           @default("WHATSAPP")
  direction      MessageDirection @default(OUTBOUND)
  generatedByAi  Boolean          @default(false)
  fromPhone      String?
  reminderKind   ReminderKind?
  templateParams String[]
  dedupeKey      String?          @unique
  waMessageId    String?          @unique
  deliveryStatus String?
  failure        String?
  scheduledFor   DateTime?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  legalCase      LegalCase?       @relation(fields: [caseId], references: [id])
  client         Client?          @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([caseId, createdAt])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  notes       String?
  priority    TaskPriority @default(NORMAL)
  completedAt DateTime?
  dueAt       DateTime?
  assigneeId  String
  caseId      String?
  judgmentId  String?      @unique
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  assignee    User         @relation(fields: [assigneeId], references: [id])
  legalCase   LegalCase?   @relation(fields: [caseId], references: [id])

  @@index([assigneeId, completedAt])
}

model Document {
  id           String           @id @default(cuid())
  caseId       String
  title        String
  fileName     String
  mimeType     String
  size         Int
  content      Bytes
  pageCount    Int              @default(0)
  extraction   ExtractionStatus @default(READY)
  category     DocumentCategory @default(OTHER)
  version      Int              @default(1)
  rootId       String?
  uploadedById String
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  legalCase    LegalCase        @relation(fields: [caseId], references: [id])
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  pages        DocumentPage[]
  judgments    Judgment[]

  @@index([caseId, createdAt])
  @@index([rootId])
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  page       Int
  text       String
  searchText String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, page])
}

model Judgment {
  id                  String    @id @default(cuid())
  caseId              String
  judgmentNumber      String?
  title               String
  court               String?
  decidedAt           DateTime
  notifiedAt          DateTime?
  summary             String
  appealFiledAt       DateTime?
  appealDeadline      DateTime?
  proposedDeadline    DateTime?
  deadlineRule        Json?
  deadlineConfirmedBy String?
  deadlineConfirmedAt DateTime?
  documentId          String?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?
  legalCase           LegalCase @relation(fields: [caseId], references: [id])
  document            Document? @relation(fields: [documentId], references: [id])

  @@index([caseId, decidedAt])
  @@index([appealDeadline])
}

model LegalDraft {
  id            String      @id @default(cuid())
  caseId        String
  title         String
  kind          DraftKind   @default(MEMO)
  body          String
  status        DraftStatus @default(DRAFT)
  generatedByAi Boolean     @default(false)
  sources       Json?
  createdById   String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  legalCase     LegalCase   @relation(fields: [caseId], references: [id])
  createdBy     User        @relation("DraftAuthor", fields: [createdById], references: [id])
  reviewedBy    User?       @relation("DraftReviewer", fields: [reviewedById], references: [id])

  @@index([caseId, createdAt])
  @@index([status])
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  caseId    String?
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  legalCase LegalCase?    @relation(fields: [caseId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  sources        Json?
  drafts         Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ConsultationRequest {
  id          String             @id @default(cuid())
  name        String
  phone       String
  email       String?
  topic       String
  message     String
  preferredAt DateTime?
  status      ConsultationStatus @default(NEW)
  createdAt   DateTime           @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String
  caseId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime   @default(now())
  legalCase  LegalCase? @relation(fields: [caseId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([caseId, createdAt])
  @@index([userId, createdAt])
}

model CaseUpdate {
  id            String     @id @default(cuid())
  caseId        String
  kind          UpdateKind
  occurredAt    DateTime
  note          String
  nextHearingAt DateTime?
  createdById   String
  createdAt     DateTime   @default(now())
  legalCase     LegalCase  @relation(fields: [caseId], references: [id])
  createdBy     User       @relation(fields: [createdById], references: [id])

  @@index([caseId, occurredAt])
}

model OfficeSetting {
  id             Int       @id @default(1)
  aiEnabled      Boolean   @default(false)
  aiEnabledBy    String?
  aiEnabledAt    DateTime?
  quietStart     Int       @default(9)
  quietEnd       Int       @default(20)
  staleDays      Int       @default(30)
  officeWhatsapp String?
  officeAddress  String?
  officeMapUrl   String?
  officePhoto    Bytes?
  officePhotoMimeType String?
  aiApiKey       String?
  aiProvider     String?
  aiModel        String?
  updatedAt      DateTime  @updatedAt
}

model DeadlineRule {
  id              String       @id @default(cuid())
  name            String
  caseType        CaseType?
  court           CourtLevel?
  days            Int
  base            DeadlineBase
  legalBasis      String
  rollForward     Boolean      @default(false)
  pauseInVacation Boolean      @default(false)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
}

model MessageTemplate {
  id         String       @id @default(cuid())
  kind       ReminderKind @unique
  name       String
  body       String
  metaName   String?
  language   String       @default("ar")
  autoSend   Boolean      @default(false)
  autoSendBy String?
  active     Boolean      @default(true)
  updatedAt  DateTime     @updatedAt
}

model AgentRun {
  id        String   @id @default(cuid())
  agent     String
  userId    String
  caseId    String?
  input     Json
  output    Json?
  status    String
  model     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([agent, createdAt])
  @@index([userId, createdAt])
}

model IntakeItem {
  id              String       @id @default(cuid())
  fileName        String
  mimeType        String
  size            Int
  content         Bytes
  text            String       @default("")
  extracted       Json?
  matchedClientId String?
  matchScore      Float?
  status          IntakeStatus @default(NEEDS_REVIEW)
  reviewNote      String?
  caseId          String?
  createdById     String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
}

model LegalSource {
  id        String         @id @default(cuid())
  title     String
  reference String
  fileName  String?
  mimeType  String?
  size      Int?
  content   Bytes?
  addedById String
  createdAt DateTime       @default(now())
  deletedAt DateTime?
  articles  LegalArticle[]
}

model LegalArticle {
  id         String      @id @default(cuid())
  sourceId   String
  number     String
  text       String
  searchText String
  source     LegalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model Invoice {
  id           String               @id @default(cuid())
  caseId       String
  number       String               @unique
  amount       Decimal              @db.Decimal(12, 2)
  issuedAt     DateTime
  dueAt        DateTime?
  notes        String?
  /// The part of `amount` billed for expenses and hours rather than the agreed fees.
  extrasAmount Decimal              @default(0) @db.Decimal(12, 2)
  createdAt    DateTime             @default(now())
  deletedAt    DateTime?
  legalCase    LegalCase            @relation(fields: [caseId], references: [id])
  payments     Payment[]
  installments InvoiceInstallment[]
  expenses     CaseExpense[]
  timeEntries  TimeEntry[]

  @@index([caseId])
}

model InvoiceInstallment {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Decimal  @db.Decimal(12, 2)
  dueAt        DateTime
  method       String?
  chequeNumber String?
  chequeBank   String?
  chequeDrawer String?
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, dueAt])
}

model Payment {
  id           String    @id @default(cuid())
  invoiceId    String
  amount       Decimal   @db.Decimal(12, 2)
  paidAt       DateTime
  method       String?
  chequeNumber String?
  chequeBank   String?
  chequeDrawer String?
  chequeDueAt  DateTime?
  createdAt    DateTime  @default(now())
  invoice      Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// Money the office spends on a case: court fees, stamps, experts, travel.
model CaseExpense {
  id          String    @id @default(cuid())
  caseId      String
  amount      Decimal   @db.Decimal(12, 2)
  spentAt     DateTime
  category    String
  description String?
  billable    Boolean   @default(true)
  invoiceId   String?
  createdById String
  createdAt   DateTime  @default(now())
  legalCase   LegalCase @relation(fields: [caseId], references: [id])
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([caseId, spentAt])
  @@index([invoiceId])
}

/// Time a staff member spent on a case.
model TimeEntry {
  id          String    @id @default(cuid())
  caseId      String
  userId      String
  minutes     Int
  workedAt    DateTime
  description String
  billable    Boolean   @default(true)
  invoiceId   String?
  createdAt   DateTime  @default(now())
  legalCase   LegalCase @relation(fields: [caseId], references: [id])
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id])

  @@index([caseId, workedAt])
  @@index([userId, workedAt])
  @@index([invoiceId])
}

model DocumentTemplate {
  id        String    @id @default(cuid())
  name      String
  kind      DraftKind @default(OTHER)
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ClientOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

enum Role {
  SENIOR_LAWYER
  TRAINEE_LAWYER
  SECRETARY
  CLIENT
}

enum CaseType {
  CRIMINAL
  CIVIL
  COMMERCIAL
  PERSONAL_STATUS
  ADMINISTRATIVE
}

enum CourtLevel {
  FIRST_INSTANCE
  MAGISTRATES
  APPEAL
  CASSATION
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  CLOSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum DraftKind {
  MEMO
  LETTER
  NOTICE
  REPORT
  OTHER
}

enum DraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ExtractionStatus {
  READY
  NO_TEXT
}

enum ConsultationStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  DRAFT
  APPROVED
  SENT
  CANCELLED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum ReminderKind {
  HEARING_TWO_DAYS
  HEARING_MORNING
  JUDGMENT_ISSUED
  APPEAL_DEADLINE
}

enum DocumentCategory {
  PLEADING
  EVIDENCE
  COURT_ORDER
  CONTRACT
  POWER_OF_ATTORNEY
  CORRESPONDENCE
  OTHER
}

enum UpdateKind {
  ADJOURNMENT
  EXPERT_REQUEST
  NOTIFICATION
  DECISION
  OTHER
}

enum DeadlineBase {
  DECISION
  NOTIFICATION
}

enum IntakeStatus {
  SUGGESTED
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
}

model Holiday {
  id        String      @id @default(cuid())
  name      String
  startsOn  String
  endsOn    String
  kind      ClosureKind @default(HOLIDAY)
  createdAt DateTime    @default(now())

  @@index([startsOn])
}

enum ClosureKind {
  HOLIDAY
  JUDICIAL_VACATION
}
